.Spell(@name@).@trig@ = function() {
    // Триггер @trig@ срабатывает после разбора аргументов и ДО того, как
    // будет назначена задержка, произнесены слова заклинания и списана мана.
    // В runArg все это уже случилось, а следом заклинание еще и прокачивается
    // -- поэтому проверки "а можно ли вообще это сотворить" должны жить здесь.
    //
    //   return false -- заклинание отменяется, не потратив ничего.
    //   return true (или ничего) -- заклинание творится дальше, как обычно.
    //
    // Прием ch.wait = 0 здесь не нужен: задержки еще нет.
    //
    // Внимание: level здесь -- это уровень персонажа, а не итоговый уровень
    // заклинания. Настоящий уровень считается позже, и посчитать его раньше
    // нельзя: заодно с ним бросается и прокачивается "магическое творчество".
    //
    // Искать нужный предмет здесь можно и нужно, а вот тратить -- нельзя:
    // расход ингредиента и создание мобов остаются в runArg.

    /*
    if (ch.get_obj_inventory_vnum(21) == null) {
        ch.act("Для этого заклинания нужен слиток.");
        return false;
    }

    if (ch.in_room.room_flags & .tables.room_flags.no_mob) {
        ch.act("В эту местность нельзя позвать: сюда могут попасть только игроки.");
        return false;
    }
    */

    return true;
}
