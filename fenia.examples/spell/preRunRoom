.Spell(@name@).@trig@ = function() {
    // Триггер @trig@ срабатывает ДО того, как будет назначена задержка,
    // произнесены слова заклинания и списана мана. В runRoom все это уже
    // случилось, а следом заклинание еще и прокачивается -- поэтому проверки
    // "а можно ли вообще это сотворить" должны жить здесь.
    //
    //   return false -- заклинание отменяется, не потратив ничего.
    //   return true (или ничего) -- заклинание творится дальше, как обычно.
    //
    // Прием ch.wait = 0 здесь не нужен: задержки еще нет.
    //
    // Внимание: level здесь -- это уровень персонажа, а не итоговый уровень
    // заклинания. Настоящий уровень считается позже, и посчитать его раньше
    // нельзя: заодно с ним бросается и прокачивается "магическое творчество".
    //
    // Проверять здесь можно только самого заклинателя и комнату. Проверки
    // "подходит ли вот эта жертва" остаются в runRoom, внутри перебора: их
    // результат зависит от того, кто в комнате оказался, и от бросков.

    /*
    if (ch.in_room.clan.name != "none" && ch.in_room.clan.name != ch.clan.name) {
        ch.act("Это заклинание запрещено творить на чужих клановых территориях.");
        return false;
    }

    if (ch.in_room.room_flags & .tables.room_flags.indoors) {
        ch.act("Под крышей такое не сотворить.");
        return false;
    }
    */

    return true;
}
